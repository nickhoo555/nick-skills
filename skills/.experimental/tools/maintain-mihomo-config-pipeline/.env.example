# 默认值；首次使用时自动复制为 .env 后尝试
# 位置支持本地绝对路径或 ssh://主机别名/绝对路径
MIHOMO_PUBLISHER_SERVICE_LOCATION="/absolute/path/to/web-publisher"
MIHOMO_CONFIG_LOCATION="/absolute/path/to/config.yaml"
MIHOMO_PUBLISHED_URL="https://example.com/config.yaml"

# 订阅者；未部署或不可从当前环境维护时留空
CLASH_PARTY_SERVICE_LOCATION=""
STASH_SERVICE_LOCATION=""

# 可选转换者；不使用时留空
SUB_STORE_SERVICE_LOCATION=""
