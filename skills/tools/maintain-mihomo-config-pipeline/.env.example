# 配置发布者是普通目录，必须包含 index.yaml，可选包含 proxies/ 和 rules/
MIHOMO_CONFIG_PUBLISHER_LOCATION="ssh self-host:/home/starx/Services/caddy-wan/www/proxy/"
# 订阅者访问 index.yaml 的 HTTP(S) 地址
MIHOMO_CONFIG_PUBLISHER_URL="https://example.com/index.yaml"

# 订阅
# 本机订阅者：docker 或 clash-party
LOCAL_SUBSCRIBER="docker"
# 本机订阅者配置目录
LOCAL_SUBSCRIBER_CONFIG_DIR="ssh zephyr:/data/workdir/collection/cwd/clash-docker/"

# 可选；不使用 Sub-Store 时留空
SUB_STORE_LOCATION=""
SUB_STORE_URL=""
